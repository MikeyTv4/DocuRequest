@model DocumentRequest
@{
    ViewData["Title"] = Model.ReferenceNo;
    var steps = new[] { RequestStatus.Pending, RequestStatus.Processing, RequestStatus.ReadyForPickup, RequestStatus.Released };
    var current = Model.Status.StepIndex();
}

<section class="container page-top">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            @if (TempData["Success"] is string msg)
            {
                <div class="alert alert-success d-flex align-items-center gap-2 reveal" role="alert">
                    <i class="bi bi-check-circle-fill"></i> @msg
                </div>
            }

            <div class="form-card reveal" style="--d:.05s">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
                    <div>
                        <div class="small text-secondary">Reference number</div>
                        <div class="ref-no" id="refNo">@Model.ReferenceNo</div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-light btn-pill btn-sm" id="copyRef">
                            <i class="bi bi-clipboard me-1"></i> Copy
                        </button>
                        <span class="badge rounded-pill fs-6 @Model.Status.BadgeClass()">@Model.Status.DisplayName()</span>
                    </div>
                </div>

                @if (current >= 0)
                {
                    <div class="timeline mb-4">
                        @for (var i = 0; i < steps.Length; i++)
                        {
                            var state = i < current ? "done" : i == current ? "active" : "";
                            <div class="t-step @state" style="--d:@(i * 0.15)s">
                                <div class="t-dot"><i class="bi @(i <= current ? "bi-check-lg" : "bi-circle")"></i></div>
                                <div class="t-label">@steps[i].DisplayName()</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-danger">
                        <i class="bi bi-x-octagon-fill me-2"></i>This request was rejected.
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.StaffRemarks))
                {
                    <div class="remarks mb-4">
                        <div class="small text-secondary mb-1">Registrar remarks</div>
                        @Model.StaffRemarks
                    </div>
                }

                <dl class="row detail-list mb-0">
                    <dt class="col-sm-4">Document</dt><dd class="col-sm-8">@Model.DocumentType?.DisplayName()</dd>
                    <dt class="col-sm-4">Copies</dt><dd class="col-sm-8">@Model.Copies</dd>
                    <dt class="col-sm-4">Purpose</dt><dd class="col-sm-8">@Model.Purpose</dd>
                    <dt class="col-sm-4">Student</dt><dd class="col-sm-8">@Model.FullName (@Model.StudentId)</dd>
                    <dt class="col-sm-4">Course</dt><dd class="col-sm-8">@Model.Course</dd>
                    <dt class="col-sm-4">Pickup date</dt><dd class="col-sm-8">@(Model.PickupDate?.ToString("MMMM d, yyyy") ?? "Not specified")</dd>
                    <dt class="col-sm-4">Submitted</dt><dd class="col-sm-8">@Model.CreatedAt.ToString("MMM d, yyyy h:mm tt")</dd>
                    <dt class="col-sm-4">Last updated</dt><dd class="col-sm-8">@Model.UpdatedAt.ToString("MMM d, yyyy h:mm tt")</dd>
                </dl>
            </div>

            <div class="d-flex justify-content-between mt-3 reveal" style="--d:.15s">
                <a class="btn btn-light btn-pill" asp-action="Track" asp-route-studentId="@Model.StudentId">
                    <i class="bi bi-arrow-left me-1"></i> My requests
                </a>
                <a class="btn btn-primary btn-pill" asp-action="Create">
                    <i class="bi bi-plus-lg me-1"></i> New request
                </a>
            </div>
        </div>
    </div>
</section>
